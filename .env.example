# ─────────────────────────────────────────────
#  PrepHQ Environment Variables — v1.1.0
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# MongoDB Atlas URI
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/prephq?retryWrites=true&w=majority

# ── Admin bootstrap ─────────────────────────────────────────
# This key does two jobs:
#  1. On first boot (when no Admin account exists yet) the server
#     auto-creates an admin account: username "admin", password = this key.
#     Log in at /login.html with those, then change your password
#     from the admin panel.
#  2. It also still works as a raw "x-admin-key" header for the
#     standalone question-uploader.html tool and any scripts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=REPLACE_WITH_GENERATED_KEY

# Optional: override the auto-created bootstrap admin's username (default: admin)
ADMIN_BOOTSTRAP_USERNAME=admin

# ── JWT ──────────────────────────────────────────────────────
# Two separate secrets — access tokens and refresh tokens must never
# share a signing secret.
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_GENERATED_SECRET

# How long an access token is valid for (short-lived, refreshed silently)
JWT_ACCESS_TTL_MIN=15

# Session inactivity window — if there's no refresh call within this many
# minutes, the session dies and the user must log in again.
SESSION_INACTIVITY_MIN=180

# ── Groq (AI quiz generation) ───────────────────────────────
# Get a key from https://console.groq.com
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Credits charged per AI-generated quiz
CREDIT_COST_QUIZ_GEN=5

# Port (Render sets this automatically — leave as 3000 for local)
PORT=3000
